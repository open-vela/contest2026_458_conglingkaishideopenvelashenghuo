# USB class: CDC-ACM, not RNDIS.
#
# RNDIS was abandoned after the device side was verified byte-for-byte against
# the MS-RNDIS spec (INITIALIZE_CMPLT, QUERY_CMPLT offsets, notification
# constant, 75-byte descriptor set all compliant) and Windows' usbrndis6 still
# failed to start the miniport with CM_PROB_FAILED_START, non-deterministically
# after a ~5 s timeout.  See .workbuddy/memory/2026-09-19.md for the full trail.
#
# The decisive argument for CDC-ACM is bandwidth: this SoC's USB PHY is
# Full-Speed only (measured -- HSENAB set, POWER.HSMODE never asserted), so
# 12 Mbps / ~1 MB/s is a hard ceiling that CDC-ACM, RNDIS and vendor bulk all
# share.  WinUSB/WCID would have bought no throughput at all, and RNDIS would
# have paid 44 bytes of header per packet.  CDC-ACM also binds to the in-box
# usbser.sys with no driver install, and it is the path that already worked.
CONFIG_CDCACM=y
# Console stays on the CH9102 UART (COM8); the CDC-ACM port is for data.
# CONFIG_CDCACM_CONSOLE is not set
CONFIG_CDCACM_VENDORID=0x38F4
CONFIG_CDCACM_PRODUCTID=0xA4A7
# Endpoint assignment.  The MUSB controller on this part has a FIXED transmit
# direction per endpoint -- measured, not documented:
#
#   EP1/EP5/EP6/EP7 -> transmit capable (IN)
#   EP2/EP3/EP4     -> receive only (OUT)
#
# NuttX's defaults (intr IN=1, bulk IN=2, bulk OUT=3) therefore do not work:
# EP2/EP3 have no TX registers at all, so a TXPKTRDY write lands in RXCSR and
# is silently ignored.  That is exactly what stopped the RNDIS notification
# from ever leaving the chip.
CONFIG_CDCACM_EPBULKIN=1
CONFIG_CDCACM_EPBULKOUT=2
CONFIG_CDCACM_EPINTIN=5
CONFIG_CDCACM_EP0MAXPACKET=64
# Throughput.  The upper-half ring buffers default to 257/193 bytes, which
# throttles the link long before USB does; and more in-flight requests let the
# controller keep a packet on the wire while the next one is prepared.
CONFIG_CDCACM_RXBUFSIZE=4096
CONFIG_CDCACM_TXBUFSIZE=4096
CONFIG_CDCACM_NRDREQS=8
CONFIG_CDCACM_NWRREQS=8
# Throughput measurement app (NSH: `usbtput tx|rx|echo [secs] [dev]`).
# The USB PHY on this part is Full-Speed only, so this exists to show where we
# actually land relative to the ~1 MB/s ceiling that all USB classes share.
CONFIG_EXAMPLES_USB_TPUT=y
