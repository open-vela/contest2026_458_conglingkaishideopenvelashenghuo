# Build-loop cost.  With the timestamp enabled, libs/libc/misc/CMakeLists.txt
# creates an `always_rebuild_lib_utsname` target that touches lib_utsname.c on
# every build.  libc.a is then re-archived every time, which invalidates the
# final link and drags in the whole allsyms chain -- four links of a ~14 MB ELF
# for a one-line change (~480 s).  Disabling it costs only the build time that
# `uname` reports and brings an incremental build down to ~170 s.
CONFIG_LIBC_UNAME_DISABLE_TIMESTAMP=y
CONFIG_NET=y
# NuttX defaults CONFIG_NET_ETH_PKTSIZE to 590 when IPv6 is off, and the RNDIS
# gadget derives several host-visible values from it:
#
#   MaxTransferSize              = (4+44+22) + PKTSIZE = 660   -> too small to
#                                 hold one 1514-byte Ethernet frame
#   OID_GEN_MAXIMUM_FRAME_SIZE   = PKTSIZE             = 590   -> Windows sees a
#   OID_GEN_TRANSMIT_BLOCK_SIZE  = PKTSIZE                      590-byte NIC and
#   OID_GEN_RECEIVE_BLOCK_SIZE   = PKTSIZE                      refuses to start
#                                                               (code 10)
#   the bulk-OUT copy limit      = PKTSIZE             = 590   -> large frames
#                                                               truncated
#
# Windows queries OID_GEN_SUPPORTED_LIST, gives up, resets the port and then
# reports CM_PROB_FAILED_START.  Set the real Ethernet frame size instead.
